CLOUDMIND_DATABASE_URL=sqlite:///./cloudmind.db
CLOUDMIND_JWT_SECRET=change-this-to-a-long-random-value
CLOUDMIND_MAX_UPLOAD_BYTES=10485760
# local for development; set s3 in deployed API and provide the bucket name.
CLOUDMIND_STORAGE_BACKEND=local
CLOUDMIND_S3_BUCKET=
CLOUDMIND_AWS_REGION=us-east-1
CLOUDMIND_PRESIGNED_URL_EXPIRY_SECONDS=300
