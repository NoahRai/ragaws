CLOUDMIND_DATABASE_URL=sqlite:///./cloudmind.db
CLOUDMIND_JWT_SECRET=change-this-to-a-long-random-value
CLOUDMIND_MAX_UPLOAD_BYTES=10485760
# local for development; set s3 in deployed API and provide the bucket name.
CLOUDMIND_STORAGE_BACKEND=local
CLOUDMIND_S3_BUCKET=
CLOUDMIND_AWS_REGION=us-east-1
CLOUDMIND_PRESIGNED_URL_EXPIRY_SECONDS=300
# local executes jobs inline. In AWS: queue_backend=sqs and set this URL.
CLOUDMIND_QUEUE_BACKEND=local
CLOUDMIND_SQS_QUEUE_URL=
CLOUDMIND_WORKER_WAIT_SECONDS=20
# Comma-separated browser origins; production should be the HTTPS frontend URL only.
CLOUDMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
